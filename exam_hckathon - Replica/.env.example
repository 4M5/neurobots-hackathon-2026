# Google Gemini API Key
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_api_key_here
# Optional; defaults to behavior_model.pkl next to server.py.
BEHAVIOR_MODEL_PATH=behavior_model.pkl

# Flask development runs bind to loopback with debug/reload disabled by default.
APP_ENV=development
FLASK_DEBUG=0
FLASK_HOST=127.0.0.1
FLASK_PORT=8000

# Comma-separated additional cross-origin frontends; same-origin calls need no CORS entry.
CORS_ORIGINS=

# Exam submissions are stored locally and excluded from Git.
EXAM_DATABASE_PATH=exam_records.sqlite3
